---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Identity from '../components/Identity.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}
const { title, description = site.description, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="e8tKK8_XjvMNTjaAiBPkX3bu_03VuuQzNjcHFTMS8mI" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/assets/img/favicon/site.webmanifest" />
    <meta name="theme-color" content="#f7f7f7" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="pill" data-pill>
      <Identity part="pill" />
    </div>
    <slot />
    <footer class="footer wrap">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <nav aria-label="Rodapé">
        <a href="/">Início</a>
        <a href="/portfolio/">Portfolio</a>
      </nav>
    </footer>
    <script>
      const pill = document.querySelector('[data-pill]');
      const hero = document.querySelector('[data-hero]');
      if (pill && hero) {
        new IntersectionObserver(([e]) =>
          pill.classList.toggle('is-visible', !e.isIntersecting),
        ).observe(hero);
      } else {
        pill?.classList.add('is-visible');
      }

      const reveal = new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-visible');
            obs.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));
    </script>
  </body>
</html>
